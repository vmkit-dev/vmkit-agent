{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rotate Credentials Configuration",
  "description": "Configuration for rotating credentials via Go agent",
  "type": "object",
  "required": [
    "instance_id",
    "credential_type",
    "postgres_password",
    "jwt_secret",
    "publishable_key",
    "secret_key"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "description": "Unique instance identifier"
    },
    "credential_type": {
      "type": "string",
      "enum": ["postgres", "jwt", "api_keys", "all"],
      "description": "Type of credential to rotate"
    },
    "postgres_password": {
      "type": "string",
      "description": "New postgres password"
    },
    "jwt_secret": {
      "type": "string",
      "description": "New JWT secret"
    },
    "publishable_key": {
      "type": "string",
      "description": "New anon/publishable key"
    },
    "secret_key": {
      "type": "string",
      "description": "New service role key"
    },
    "base_dir": {
      "type": "string",
      "description": "Base directory for instances (default: /opt/supabase)"
    }
  },
  "additionalProperties": false
}
