{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enable TLS Response",
  "description": "Response from Go agent enable-tls command",
  "type": "object",
  "required": ["success", "instance_id"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether TLS enablement succeeded"
    },
    "instance_id": {
      "type": "string",
      "description": "Instance identifier"
    },
    "steps": {
      "type": "array",
      "description": "TLS enablement steps executed",
      "items": {
        "$ref": "#/definitions/step_result"
      }
    },
    "error_message": {
      "type": "string",
      "description": "Error message (present on failure)"
    },
    "failed_step": {
      "type": "string",
      "description": "Step that failed (present on failure)"
    }
  },
  "definitions": {
    "step_result": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "failed", "skipped", "in_progress"] },
        "message": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "duration": { "type": "string" }
      }
    }
  },
  "if": {
    "properties": { "success": { "const": false } }
  },
  "then": {
    "required": ["failed_step", "error_message"]
  }
}
